rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && (
        request.auth.token.admin == true ||
        request.auth.uid == 'bFGr8AtlSGQTDZ9Nel9BVXB0csC2'
      );
    }

    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /orders/{orderId} {
      allow read: if isAdmin() || (signedIn() && resource.data.customerUid == request.auth.uid);
      allow create: if false;
      allow update: if isAdmin();
      allow delete: if false;
    }

    match /profiles/{userId} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == userId);
      allow create: if signedIn() && request.auth.uid == userId
        && request.resource.data.email == request.auth.token.email;
      allow update: if signedIn() && request.auth.uid == userId
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['name', 'email', 'phone', 'address', 'createdAt', 'updatedAt']);
      allow delete: if false;

      match /favoriteFolders/{folderId} {
        allow read, create, update, delete: if signedIn() && request.auth.uid == userId;
      }
    }

    match /mail/{mailId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
